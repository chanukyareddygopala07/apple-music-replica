{
  "name": "Sonora",
  "meta": {
    "note": "Original identity for the Apple Music web replica. Accent is intentionally not the reference brand colour (trade dress). Font is the system UI stack (SF on Apple devices), matching the reference's rendered font category."
  },
  "color": {
    "bg": "#ffffff",
    "surface": "#ffffff",
    "surface2": "#f5f5f7",
    "border": "#d8d8dc",
    "border-strong": "#b8b8bd",
    "border-input": "#86868b",
    "text": "#1d1d1f",
    "text-secondary": "#6e6e73",
    "text-tertiary": "#8e8e93",
    "accent": "#6a45f2",
    "accent-strong": "#5a37e0",
    "on-accent": "#ffffff",
    "accent-soft": "#eeeaff",
    "danger": "#d32f33",
    "success": "#1f7a4d",
    "warning": "#8a6d1d",
    "dark": {
      "bg": "#000000",
      "surface": "#161618",
      "surface2": "#1c1c1e",
      "border": "#3a3a3c",
      "border-strong": "#48484a",
      "border-input": "#636366",
      "text": "#ebebf0",
      "text-secondary": "#98989d",
      "text-tertiary": "#6e6e73",
      "accent": "#9d86ff",
      "accent-strong": "#b09bff",
      "on-accent": "#ffffff",
      "accent-soft": "#2a2350",
      "danger": "#ff6369",
      "success": "#3dd68c",
      "warning": "#f5c451"
    }
  },
  "type": {
    "font-family": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "scale": {
      "caption2": { "size": "11px", "line": "1.27", "weight": "400" },
      "caption": { "size": "12px", "line": "1.33", "weight": "400" },
      "footnote": { "size": "13px", "line": "1.38", "weight": "400" },
      "subhead": { "size": "14px", "line": "1.43", "weight": "400" },
      "callout": { "size": "16px", "line": "1.375", "weight": "400" },
      "headline": { "size": "17px", "line": "1.24", "weight": "600" },
      "title3": { "size": "20px", "line": "1.2", "weight": "700" },
      "title2": { "size": "24px", "line": "1.17", "weight": "700" },
      "title1": { "size": "28px", "line": "1.14", "weight": "700" },
      "largeTitle": { "size": "34px", "line": "1.1", "weight": "700" },
      "hero": { "size": "48px", "line": "1.05", "weight": "800" }
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "32px", "8": "40px", "9": "48px", "10": "64px" },
  "radius": { "xs": "4px", "sm": "6px", "md": "10px", "lg": "12px", "pill": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,0.06), 0 4px 14px rgba(0,0,0,0.06)",
    "card-dark": "0 1px 2px rgba(0,0,0,0.4), 0 6px 20px rgba(0,0,0,0.45)",
    "art": "0 4px 14px rgba(0,0,0,0.20)",
    "floating": "0 8px 32px rgba(0,0,0,0.18)"
  },
  "layout": {
    "sidebar-width": "260px",
    "player-height": "72px",
    "mobile-tabs-height": "52px",
    "mobile-player-height": "64px",
    "content-gutter": "40px",
    "content-gutter-mobile": "16px",
    "art-radius-card": "6px",
    "art-radius-hero": "12px"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "pairs": [
    ["text", "bg", "normal"],
    ["text", "surface2", "normal"],
    ["text-secondary", "bg", "normal"],
    ["text-secondary", "surface2", "normal"],
    ["accent", "bg", "normal"],
    ["accent", "surface2", "normal"],
    ["on-accent", "accent", "normal"],
    ["danger", "bg", "normal"],
    ["success", "bg", "normal"],
    ["warning", "bg", "normal"],
    ["border-input", "bg", "ui"]
  ]
}
