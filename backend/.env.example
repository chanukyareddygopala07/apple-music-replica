# Realaxify backend (FastAPI) — defaults shown. The server reads plain
# process env vars (no dotenv loader): `set -a; source backend/.env; set +a`
# before `uvicorn app.main:app`, or export what you need inline.
# All values shown are the defaults; empty = default (providers without a
# credential are 'unconfigured' and simply offer no data).

ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

# Providers (server-side credentials — unlike VITE_* these are NOT public,
# never commit them)
AUDIUS_ENABLED=1
AUDIUS_API_KEY=
AUDIUS_BASE_URL=https://api.audius.co/v1
JAMENDO_ENABLED=1
JAMENDO_CLIENT_ID=
JAMENDO_BASE_URL=https://api.jamendo.com/v3.0
YOUTUBE_ENABLED=1
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# Lyrics (LRCLIB — free, no key; set LYRICS_ENABLED=0 to turn off)
LYRICS_ENABLED=1
LRCLIB_BASE_URL=https://lrclib.net

# Transport / limits
HTTP_TIMEOUT_S=8
CACHE_TTL_S=60
CACHE_NEGATIVE_TTL_S=15
CACHE_MAX_ENTRIES=512
PROVIDER_REQUEST_GAP_MS=130
MAX_QUERY_LENGTH=200
SEARCH_LIMIT=20
MAX_CONCURRENT_SOURCES=4
