# Audius (primary external music provider) — free public API.
# https://docs.audius.co — ON BY DEFAULT; anonymous access works with no
# credentials. Disable explicitly for demo-only mode:
#   VITE_AUDIUS_ENABLED=0
VITE_AUDIUS_ENABLED=

# Optional free-plan API key (https://creator.audius.co). The official SDK
# sends it from the browser as an `api_key` query parameter — same transport
# here. Leave empty for anonymous access. Public build-time value, not a
# secret: Vite embeds every VITE_* variable in the client bundle.
VITE_AUDIUS_API_KEY=

# Apple MusicKit (optional) — PUBLIC configuration only.
# Never put your .p8 private key or any signing secret in this repository:
# signing happens on a separate private token service (see README).
#
# Two-key activation gate — MusicKit activates ONLY when the flag is on AND
# a token source is set. Without both, the app runs pure demo mode and makes
# zero MusicKit network requests.
VITE_MUSICKIT_ENABLED=

# 1) Recommended: token-signing service URL returning JSON { "token": "<jwt>" }.
#    The service (not this repo) holds the .p8 and asserts the origin claim.
VITE_MUSICKIT_TOKEN_URL=

# 2) Local development only: a pre-signed short-lived developer token.
#    The token-signing service can mint one for you; do not commit it.
VITE_MUSICKIT_DEVELOPER_TOKEN=

# Jamendo (free Creative Commons catalogue) — optional provider.
# Get a free client id: https://devportal.jamendo.com → sign up → create an
# application (read-only plan) → copy its client id. Accept their API terms.
#
# PUBLIC build-time value, not a secret: Vite embeds every VITE_* variable in
# the client bundle, and Jamendo's own docs publish a test id for read calls.
# Never put OAuth access tokens or client secrets in VITE_* variables (this
# app only uses the unauthenticated read API).
#
# Provider behaviour: enabled by default but *unconfigured* without an id —
# the source then never appears in the selector and no request is made.
#   VITE_JAMENDO_ENABLED=0    force-off even with a client id
VITE_JAMENDO_ENABLED=
VITE_JAMENDO_CLIENT_ID=

# YouTube discovery (YouTube Data API v3) — optional provider.
# Get a free API key: https://console.cloud.google.com → create a project →
# enable "YouTube Data API v3" → Credentials → Create API key → restrict the
# key by HTTP referrer (your dev/production URLs) under API restrictions.
#
# PUBLIC build-time value, not a secret: Vite embeds every VITE_* variable in
# the client bundle (referrer restriction is the real protection). Quota:
# the free tier allows 100 search.list calls/day (this app spends 1 search +
# 1 cheap videos.list per query, maxResults=10).
#
# Playback needs NO key — the official IFrame embed plays on /watch even when
# this is empty. Provider behaviour mirrors Jamendo: enabled by default but
# *unconfigured* without a key — the source is then omitted from the selector,
# ?src=youtube shows an honest setup notice, and zero requests are made.
#   VITE_YOUTUBE_ENABLED=0     force-off even with a key
VITE_YOUTUBE_ENABLED=
VITE_YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Realaxify API client (browser → backend, optional)
# ---------------------------------------------------------------------------
# The frontend works fully offline (direct providers + demo catalogue). With a
# backend running, it can instead use the FastAPI server (backend/) as one
# aggregated proxy: /api/search, /api/tracks/:id, /api/lyrics, /api/providers.
#
# VITE_API_BASE   Origin serving the API (defaults to the page's own origin,
#                 so a reverse proxy can mount /api alongside the static app).
#                 Set to http://127.0.0.1:8000 to talk to a local uvicorn.
#                 Like every VITE_* value this is PUBLIC and baked into the
#                 bundle — it must never contain credentials.
VITE_API_BASE=

# VITE_API_ENABLED  '' (unset) = probe /api/health once per session and fall
#                   back to direct providers on failure (sticky for the tab).
#                   '1'/'on' = assume the API exists (no probe request).
#                   '0'/'off' = never contact the API (demo-only builds, e2e).
VITE_API_ENABLED=

# VITE_API_PROXY  vite dev/preview server proxy target for /api
#                 (default http://127.0.0.1:8000; 'off' disables the proxy).
#                 Ignored when VITE_API_BASE is set.
VITE_API_PROXY=
