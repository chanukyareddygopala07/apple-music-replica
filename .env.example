# Audius (primary external music provider) — free public API.
# https://docs.audius.co — ON BY DEFAULT; anonymous access works with no
# credentials. Disable explicitly for demo-only mode:
#   VITE_AUDIUS_ENABLED=0
VITE_AUDIUS_ENABLED=

# Optional free-plan API key (https://creator.audius.co). The official SDK
# sends it from the browser as an `api_key` query parameter — same transport
# here. Leave empty for anonymous access. Public build-time value, not a
# secret: Vite embeds every VITE_* variable in the client bundle.
VITE_AUDIUS_API_KEY=

# Apple MusicKit (optional) — PUBLIC configuration only.
# Never put your .p8 private key or any signing secret in this repository:
# signing happens on a separate private token service (see README).
#
# Two-key activation gate — MusicKit activates ONLY when the flag is on AND
# a token source is set. Without both, the app runs pure demo mode and makes
# zero MusicKit network requests.
VITE_MUSICKIT_ENABLED=

# 1) Recommended: token-signing service URL returning JSON { "token": "<jwt>" }.
#    The service (not this repo) holds the .p8 and asserts the origin claim.
VITE_MUSICKIT_TOKEN_URL=

# 2) Local development only: a pre-signed short-lived developer token.
#    The token-signing service can mint one for you; do not commit it.
VITE_MUSICKIT_DEVELOPER_TOKEN=
