{
  "name": "sonora-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sonora — an original, framework-free Apple Music-inspired web player (demo catalogue + optional MusicKit path).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:reference": "node scripts/capture-reference.mjs",
    "capture:clone": "node scripts/capture-clone.mjs",
    "smoke:musickit": "node scripts/musickit-smoke.mjs",
    "smoke:audius": "node scripts/audius-smoke.mjs",
    "smoke:jamendo": "node scripts/jamendo-smoke.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
